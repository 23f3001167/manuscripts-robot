# ------------------------------------------------------------------
# Graduate Robot · Voice Assistant configuration
# ------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values.
# The ".env" file is git-ignored and is NOT included when you share
# the project as a zip, so your secret key stays private.
# ------------------------------------------------------------------

# Groq API key used by the local Vite proxy (server-side only).
# Get a free key at: https://console.groq.com/keys
# This value is NEVER exposed to the browser bundle.
GROQ_API_KEY=your_groq_api_key_here

# Model served by Groq. Defaults to openai/gpt-oss-120b if omitted.
# This is a public, non-secret value.
VITE_GROQ_MODEL=openai/gpt-oss-120b